{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OCRBlock",
  "description": "A block of text detected via OCR in a video frame",
  "type": "object",
  "required": ["text", "frame_path", "timestamp", "confidence"],
  "properties": {
    "text": {
      "type": "string",
      "description": "OCR-detected text content"
    },
    "text_normalized": {
      "type": "string",
      "description": "Normalized OCR text"
    },
    "frame_path": {
      "type": "string",
      "description": "Path to the frame image where text was detected"
    },
    "timestamp": {
      "type": "number",
      "minimum": 0,
      "description": "Video timestamp in seconds when this frame was captured"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "OCR confidence score"
    },
    "engine": {
      "type": "string",
      "enum": ["tesseract", "rapidocr", "paddleocr", "opencv_dnn", "vision_model"],
      "description": "OCR engine used for detection"
    },
    "language": {
      "type": "string",
      "description": "Detected language of the OCR text"
    },
    "bounding_box": {
      "type": "object",
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 0},
        "height": {"type": "integer", "minimum": 0}
      },
      "description": "Bounding box of the detected text region"
    },
    "frame_width": {"type": "integer", "minimum": 1},
    "frame_height": {"type": "integer", "minimum": 1},
    "rotation": {"type": "integer", "description": "Frame rotation in degrees"},
    "is_diagram": {"type": "boolean"},
    "is_code": {"type": "boolean"},
    "is_table": {"type": "boolean"},
    "is_screenshot": {"type": "boolean"},
    "element_type": {
      "type": "string",
      "enum": ["text", "diagram", "code", "table", "interface", "chart", "flowchart", "screenshot", "unknown"],
      "description": "Type of visual element detected"
    }
  },
  "additionalProperties": false
}
